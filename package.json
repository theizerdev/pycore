{
  "name": "pycore",
  "version": "1.0.0",
  "private": true,
  "description": "PyCore - Enterprise Multi-Tenant SaaS & Core Boilerplate (FastAPI + React 19)",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"green.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm.cmd run dev",
    "build": "cd frontend && npm.cmd run build",
    "test:api": "cd backend && .\\venv\\Scripts\\python.exe test_api.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}