# ==============================================================================
# PyCore - Master .gitignore
# Repositorio Full-Stack (FastAPI + React 19 + TypeScript + MySQL/SQLite)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencias y Entornos Virtuales
# ------------------------------------------------------------------------------
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
*/venv/
*/.venv/
*/env/

# ------------------------------------------------------------------------------
# 2. Archivos de Entorno y Secretos (Seguridad Crítica)
# ------------------------------------------------------------------------------
# Ignorar todos los .env con credenciales reales
.env
.env.*
!.env.example
!.env.*.example
backend/.env
frontend/.env
*.local
*.env.local

# Claves criptográficas y certificados
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 3. Compilación, Caches y Archivos Temporales
# ------------------------------------------------------------------------------
# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend builds & caches (Vite / TypeScript / Bundlers)
frontend/dist/
frontend/dist-ssr/
frontend/.tmp/
*.tsbuildinfo
.vite/
.eslintcache

# ------------------------------------------------------------------------------
# 4. Bases de Datos Locales y Almacenamiento
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
medflow.db
pycore.db
backend/medflow.db
backend/pycore.db

# Backups y volcados SQL
*.sql.gz
*.dump

# ------------------------------------------------------------------------------
# 5. Logs y Archivos de Ejecución
# ------------------------------------------------------------------------------
logs/
*.log
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. Editores, IDEs y Sistema Operativo
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Sistema Operativo - Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Sistema Operativo - macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Sistema Operativo - Linux / VIM
*~
*.swp
*.swo
